{
  "schemaVersion": 1,
  "id": "dizziee.auto-wallpaper",
  "name": "Auto Wallpaper",
  "version": "1.0.0",
  "author": "Dizziee",
  "license": "MIT",
  "description": "Preview the active theme's wallpapers and switch them on an interval or daily schedule.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Auto Wallpaper",
    "description": "Preview and automatically schedule the active theme's wallpapers.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "scheduleType": "interval",
      "intervalMinutes": 30,
      "mode": "sequential",
      "dailyEntries": []
    },
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Automatic switching",
        "description": "Start cycling wallpapers automatically.",
        "defaultValue": true
      },
      {
        "key": "scheduleType",
        "type": "enum",
        "label": "Schedule",
        "options": ["interval", "daily"],
        "defaultValue": "interval"
      },
      {
        "key": "intervalMinutes",
        "type": "integer",
        "label": "Interval (minutes)",
        "description": "How often the wallpaper changes.",
        "min": 5,
        "max": 1440,
        "defaultValue": 30
      },
      {
        "key": "mode",
        "type": "enum",
        "label": "Order",
        "options": ["sequential", "shuffle"],
        "defaultValue": "sequential"
      }
    ]
  }
}
